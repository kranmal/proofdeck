{
  "name": "proofdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Test management with one-click bug reports from failed steps",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec --test-concurrency=4",
    "reset-password": "node --disable-warning=ExperimentalWarning scripts/reset-password.js",
    "check-integration": "node --disable-warning=ExperimentalWarning scripts/check-integration.js"
  },
  "engines": {
    "node": ">=22.13"
  }
}
